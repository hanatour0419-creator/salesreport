}
function chips(arr,sel,group){
  return arr.map(v=>`<div class="chip ${sel===v?'on':''}" onclick="pickChip('${group}','${v}')">${v}</div>`).join('');
}
function pickChip(group,v){
  if(group==='promoCh') form.promo.channel = form.promo.channel===v?'':v;
  if(group==='promoRes') form.promo.result = v;
  if(group==='noteUrg') form.note.urgency = v;
