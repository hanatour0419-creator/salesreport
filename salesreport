/* ===== 유틸 ===== */
function esc(s){return (s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
function fmtDate(d){return `${d.getFullYear()}.${p2(d.getMonth()+1)}.${p2(d.getDate())} (${'일월화수목금토'[d.getDay()]})`;}
function fmtTime(d){return `${p2(d.getHours())}:${p2(d.getMinutes())}`;}
function p2(n){return String(n).padStart(2,'0');}
function timeAgo(d){const m=Math.floor((Date.now()-d.getTime())/60000);
  if(m<1)return '방금';if(m<60)return m+'분 전';const h=Math.floor(m/60);if(h<24)return h+'시간 전';return Math.floor(h/24)+'일 전';}
function toast(msg){
  const t=document.createElement('div');t.className='toast';t.innerHTML=`<span class="live-dot"></span>${msg}`;
  document.getElementById('toastHost').appendChild(t);
  setTimeout(()=>t.remove(),2200);
}

/* ===== 샘플 데이터 (데모용) ===== */
function seedSample(){
  const now=Date.now();
  // 오늘 샘플은 '오늘 날짜 + 지정 시각'으로 고정해 자정 경계와 무관하게 당일로 잡히게 함
  function todayAt(h,m){const d=new Date();d.setHours(h,m,0,0); if(d.getTime()>now) d.setTime(now-60000); return d;}
  function mk(name,when,target,sections,extra){
    const s=DB.sales.map(x=>({name:x[0],team:x[1],dept:x[2],teamLead:x[3],deptHead:x[4]})).find(p=>p.name===name);
    if(!s)return null;
    const ts = (when instanceof Date) ? when : new Date(now-when*60000);
    return Object.assign({
      id:+ts,ts,
      name:s.name,team:s.team,dept:s.dept,teamLead:s.teamLead,deptHead:s.deptHead,
      target,agencies:[],sections,
      promo:{name:'',channel:'',count:0,reach:0,bookings:0,amount:0,result:'중',memo:''},
      inc:{signed:[],unsigned:[],signedAmt:0,signNote:'',unsignNote:''},
      note:{text:'',urgency:'보통'},etc:{text:''}
    },extra);
  }
  const DAY=1440;
