/* --- 로그인 게이트 (본인 선택 + PIN) --- */
/* 개인별 PIN (이름→PIN). 미지정자는 기본 PIN(0000) 사용.
   ※ 추후 각 팀장·부서장 PIN을 여기에 추가하세요. */
const PIN_MAP = {
  '최정수':'1111',   // 영업1팀 팀장
  '서민구':'1111',   // 영업2부 부서장
};
const DEFAULT_PIN='0000';
function pinFor(name){ return PIN_MAP[name] || DEFAULT_PIN; }
function loginGate(scope){
  const isLead = scope==='lead';
  const people = isLead
    ? sortDepts([...new Set(Object.values(TL))].map(n=>n)) // 정렬은 이름 기준으로 아래서 재처리
    : [...new Set(Object.values(DH))];
  // 팀장: 부서>팀 순으로 정렬해 표시 / 부서장: 부서 순
  let opts='';
  if(isLead){
    // 팀장 목록을 부서 순 → 팀 순으로
    const entries=Object.keys(TL).map(team=>({team,dept:teamDept(team),name:TL[team]}))
      .filter(e=>!EXCLUDE_DEPTS.includes(e.dept));
    entries.sort((a,b)=>{
      const da=DEPT_ORDER.indexOf(a.dept), db=DEPT_ORDER.indexOf(b.dept);
      return (da<0?99:da)-(db<0?99:db) || a.team.localeCompare(b.team,'ko',{numeric:true});
    });
    const seen=new Set();
    entries.forEach(e=>{ if(seen.has(e.name))return; seen.add(e.name);
      opts+=`<option value="${e.name}">${e.name} 팀장 (${e.team})</option>`; });
  } else {
    const entries=Object.keys(DH).map(dept=>({dept,name:DH[dept]}))
      .filter(e=>!EXCLUDE_DEPTS.includes(e.dept));
    entries.sort((a,b)=>{const da=DEPT_ORDER.indexOf(a.dept),db=DEPT_ORDER.indexOf(b.dept);return (da<0?99:da)-(db<0?99:db);});
    entries.forEach(e=>{ opts+=`<option value="${e.name}">${e.name} 부서장 (${e.dept})</option>`; });
  }
  const cur = isLead?leadWho:headWho;
  const sel = `onchange="${isLead?'leadWho':'headWho'}=this.value"`;
  return `<div class="card login-card">
    <div class="login-ic">${isLead?'👔':'🏢'}</div>
    <h2>${isLead?'팀장':'부서장'} 로그인</h2>
    <p class="login-sub">본인 계정으로 로그인해야 보고를 볼 수 있습니다.<br>팀원·타 부서는 열람할 수 없습니다.</p>
    <label>${isLead?'팀장':'부서장'} 선택</label>
    <select id="${scope}LoginSel" ${sel}><option value="">${isLead?'팀장':'부서장'}을 선택하세요</option>${opts}</select>
    <label>PIN 번호</label>
    <input class="inp" type="password" inputmode="numeric" maxlength="4" placeholder="••••"
      oninput="${isLead?'leadPinInput':'headPinInput'}=this.value">
    <button class="btn btn-pri" style="width:100%;margin-top:16px" onclick="loginDash('${scope}')">로그인</button>
    <div class="login-note">🔑 테스트 계정 — 최정수 팀장 / 서민구 부서장 · PIN <b>1111</b><br>그 외 계정은 임시 PIN <b>0000</b> · 실제 운영 시 개인별 비밀번호/사내 SSO로 연동하세요.</div>
  </div>`;
}
function teamDept(team){
  // 팀이 속한 부서 찾기 (SALES 기반, 없으면 대리점기준)
