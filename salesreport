  html += `<div class="step-head"><div class="step-num">${curStep+1}</div><div><h2>${STEPS[curStep]}</h2><div class="d">${stepDesc(curStep)}</div></div></div>`;
  html += stepBody(curStep);
  // 카드 내부 인라인 진행 버튼 (자동진행 단계 제외) — 하단 고정바가 안 보일 때도 항상 누를 수 있게
  const inlineAuto = (curStep===0 || curStep===1);
  if(!inlineAuto){
    const okNow = canNext();
    const lbl = curStep===STEPS.length-1 ? '제출하기 ✓' : '다음 →';
    html += `<div class="inline-nav">
      ${curStep>0?`<button class="btn btn-sec" onclick="step(-1)">← 이전</button>`:''}
      <button class="btn btn-pri ${okNow?'ready':''}" ${okNow?'':'disabled'} onclick="step(1)">${lbl}</button>
    </div>`;
  }
  html += `</div>`;
  host.innerHTML = html;
  // 하단 고정 네비바는 사용하지 않음 (카드 내부 인라인 버튼으로 대체 — 모바일에서 안정적)
  document.getElementById('navBar').classList.add('hide');
  bindStep(curStep);
}

function stepDesc(s){
  return ['소속 부서를 선택하세요','부서 내 팀을 선택하세요','담당자 본인과 대리점 선택','보고 대상 + 보고할 항목 선택','각 항목 내용을 입력','보고 대상에게 실시간 전송'][s];
}

/* 상단 브레드크럼: 클릭하면 해당 단계로 이동 */
function breadcrumb(){
  const parts=[];
  parts.push({label: myDept?('🏢 '+myDept):'🏢 부서', step:0, on:!!myDept});
  if(myDept) parts.push({label: myTeam?('👥 '+myTeam):'👥 팀', step:1, on:!!myTeam});
  if(myTeam) parts.push({label: me?('👤 '+me.name):'👤 담당자', step:2, on:!!me});
  if(parts.length<=1 && !myDept) return ''; // 첫 화면엔 숨김
  let h='<div class="bcrumb">';
  parts.forEach((p,i)=>{
    if(i>0) h+='<span class="bc-sep">›</span>';
    const cls = p.on?'bc-link':'bc-link bc-empty';
    h+=`<button class="${cls} ${curStep===p.step?'cur':''}" onclick="gotoStep(${p.step})">${p.label}</button>`;
  });
  h+='</div>';
  return h;
}
function gotoStep(s){
  if(s>curStep) return;          // 브레드크럼으로는 앞 단계로만 이동(되돌아가기)
  curStep=s;
  renderSales(); window.scrollTo(0,0);
}

function stepBody(s){
  if(s===0) return bodyDept();
  if(s===1) return bodyTeam();
  if(s===2) return bodyMember();
  if(s===3) return bodySections();
  if(s===4) return bodyContent();
  if(s===5) return bodyReview();
}

/* --- 부서 > 팀 구조 (담당자가 존재하는 팀만) --- */
function deptTeamMap(){
  const m={};
  SALES.forEach(s=>{ if(!m[s.dept])m[s.dept]={}; m[s.dept][s.team]=true; });
  return m;
}
/* 부서 표시 순서(지정 순서 우선, 나머지는 뒤에) */
function sortDepts(arr){
  return arr.slice().sort((a,b)=>{
    let ia=DEPT_ORDER.indexOf(a), ib=DEPT_ORDER.indexOf(b);
    if(ia<0) ia=DEPT_ORDER.length; if(ib<0) ib=DEPT_ORDER.length;
    return ia-ib || a.localeCompare(b,'ko');
  });
}

/* --- STEP1: 부서 선택 --- */
function bodyDept(){
  const dtm = deptTeamMap();
  const depts = sortDepts(Object.keys(dtm));
  let h = `<label>소속 부서 <span class="req">*</span> <span class="auto-hint">선택하면 자동으로 넘어갑니다</span></label><div class="big-pick">`;
  depts.forEach(d=>{
    const cnt = SALES.filter(s=>s.dept===d).length;
    const teams = Object.keys(dtm[d]).length;
    h += `<button class="big-chip ${myDept===d?'on':''}" onclick="pickDept('${d}')">
      <span class="bc-ic">🏢</span><span class="bc-t">${d}</span>
      <span class="bc-s">${teams}개 팀 · ${cnt}명</span></button>`;
  });
  h += `</div>`;
  return h;
}
function pickDept(d){
  myDept=d; myTeam=null; me=null; form.agencies=[];
  curStep=1;                 // 부서 고르면 바로 팀 선택 단계로
  renderSales(); window.scrollTo(0,0);
}

/* --- STEP2: 팀 선택 --- */
function bodyTeam(){
  if(!myDept) return `<div class="empty"><div class="ic">🏢</div><p>먼저 부서를 선택하세요</p></div>`;
