function normName(n){ return (n||'').replace(/[A-Z]+$/,'').trim(); }
/* 담당자(me)의 담당 대리점: 이름 정규화 + 같은 팀 우선 매칭 */
function myAgencies(){
  if(!me) return [];
  const n = normName(me.name);
  return AG.filter(a=> normName(a.manager)===n && (a.team===me.team || a.team===''||!a.team));
}

