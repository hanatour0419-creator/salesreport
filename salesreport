/* ===== 기간(일간/주간) 유틸 ===== */
function inPeriod(ts,period){
  const d=new Date(ts), now=new Date();
  if(period==='week'){
    // 이번 주 (월요일 00:00 ~ 현재)
    const mon=new Date(now); const wd=(now.getDay()+6)%7; // 월=0
    mon.setDate(now.getDate()-wd); mon.setHours(0,0,0,0);
    return d>=mon;
  }
  // 오늘 (당일 00:00 ~)
  const t0=new Date(now); t0.setHours(0,0,0,0);
  return d>=t0;
}
function periodToggle(scope){
  const p = scope==='lead'?leadPeriod:headPeriod;
  return `<div class="period-toggle">
    <button class="${p==='day'?'on':''}" onclick="setPeriod('${scope}','day')">📅 일간 (오늘)</button>
    <button class="${p==='week'?'on':''}" onclick="setPeriod('${scope}','week')">🗓️ 주간 (이번 주)</button>
  </div>`;
}
function setPeriod(scope,p){
  if(scope==='lead'){leadPeriod=p;renderLead();} else {headPeriod=p;renderHead();}
}

/* ===== 팀원/부서원 실시간 보고 현황 매트릭스 ===== */
function memberStatus(members,reps,scope){
  if(!members.length) return '';
  // 멤버별 집계
  const byName={};
  members.forEach(m=>{byName[m.name]={name:m.name,team:m.team,count:0,promo:0,inc:0,note:0,etc:0,last:null};});
  reps.forEach(r=>{
    const e=byName[r.name]; if(!e) return;
    e.count++;
    if(r.sections.promo)e.promo++; if(r.sections.inc)e.inc++;
    if(r.sections.note)e.note++; if(r.sections.etc)e.etc++;
    if(!e.last||r.ts>e.last)e.last=r.ts;
  });
  const list=Object.values(byName);
  const done=list.filter(e=>e.count>0).length;
  const rate=Math.round(done/list.length*100);
  // 보고한 사람 위로, 팀/이름 순
  list.sort((a,b)=> (b.count>0)-(a.count>0) || a.team.localeCompare(b.team,'ko',{numeric:true}) || a.name.localeCompare(b.name,'ko'));

  let h=`<div class="card mstat-card">
    <div class="mstat-head">
      <div class="mstat-title">🧑‍💼 ${scope==='lead'?'팀원':'부서원'} 실시간 보고 현황</div>
      <div class="mstat-rate"><b>${done}</b>/${list.length}명 보고 · <span class="${rate>=70?'r-good':rate>=40?'r-mid':'r-low'}">${rate}%</span></div>
    </div>
    <div class="mstat-bar"><div class="mstat-fill" style="width:${rate}%"></div></div>
    <div class="mstat-list">`;
  list.forEach(e=>{
    const reported=e.count>0;
    h+=`<div class="mrow ${reported?'on':'off'}">
      <div class="mrow-l">
        <span class="mdot ${reported?'g':''}"></span>
        <span class="mname">${e.name}</span>
        <span class="mteam">${e.team}</span>
      </div>
      <div class="mrow-r">`;
    if(reported){
      const tags=[];
      if(e.promo)tags.push(`<span class="mtag promo">📢${e.promo}</span>`);
      if(e.inc)tags.push(`<span class="mtag inc">🤝${e.inc}</span>`);
      if(e.note)tags.push(`<span class="mtag note">⚠️${e.note}</span>`);
      if(e.etc)tags.push(`<span class="mtag etc">📝${e.etc}</span>`);
      h+=`${tags.join('')}<span class="mtime">${fmtTime(e.last)}</span>`;
    } else {
      h+=`<span class="mwait">미보고</span>`;
    }
    h+=`</div></div>`;
  });
  h+=`</div></div>`;
  return h;
}

/* ===== 공용 대시보드 컴포넌트 ===== */
