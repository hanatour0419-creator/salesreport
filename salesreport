/* --- 스텝 이동 / 검증 --- */
function canNext(){
  if(curStep===0) return !!myDept;                       // 부서
  if(curStep===1) return !!myTeam;                       // 팀
  if(curStep===2){                                       // 담당자+대리점
    if(!me) return false;
    return myAgencies().length===0 || form.agencies.length>0; // 배정 대리점 없으면 통과
  }
  if(curStep===3) return Object.values(form.sections).some(v=>v); // 보고 항목
  if(curStep===4){                                       // 내용 작성
    if(form.sections.promo && !form.promo.name.trim()) return false;
    if(form.sections.note && !form.note.text.trim()) return false;
    return true;
  }
  return true;
}
function step(d){
  if(d>0 && !canNext()){toast('필수 항목을 입력하세요');return;}
  if(curStep===STEPS.length-1 && d>0){submitReport();return;}
  curStep=Math.min(STEPS.length-1,Math.max(0,curStep+d));
  renderSales();window.scrollTo(0,0);
}
function bindStep(){/* placeholder for focus etc. */}

/* --- 제출 --- */
function submitReport(){
  const rec={
    id:Date.now(),
    ts:new Date(),
    name:me.name, team:me.team, dept:me.dept,
    teamLead:me.teamLead, deptHead:me.deptHead,
