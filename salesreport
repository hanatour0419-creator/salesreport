}
function stepper(label,path){
  const val = getPath(path);
  return `<div><label style="margin-top:0">${label}</label>
    <div class="stp">
      <button onclick="bump('${path}',-1)">−</button>
      <input type="number" value="${val}" oninput="setPath('${path}',+this.value||0)">
      <button onclick="bump('${path}',1)">+</button>
    </div></div>`;
}
function incAgPicker(kind,list){
  const arr = form.inc[kind];
  return `<div class="ag-pills" style="margin:6px 0 4px">
    ${list.map(a=>`<span style="cursor:pointer;${arr.includes(a.code)?'background:var(--acc2);color:#fff':''}" onclick="toggleInc('${kind}','${a.code}')">${a.name}</span>`).join('')||'<span style="color:var(--mut)">담당 대리점 없음</span>'}
  </div>`;
}
function toggleInc(kind,code){
  const arr=form.inc[kind];const i=arr.indexOf(code);
  if(i>=0)arr.splice(i,1);else arr.push(code);
  renderSales();
}
function bump(path,d){setPath(path,Math.max(0,getPath(path)+d));renderSales();}
function getPath(p){return p.split('.').reduce((o,k)=>o[k],form);}
function setPath(p,v){const ks=p.split('.');let o=form;for(let i=0;i<ks.length-1;i++)o=o[ks[i]];o[ks[ks.length-1]]=v;}

